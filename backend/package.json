{
  "name": "falconstats-api",
  "version": "1.0.0",
  "private": true,
  "description": "FalconStats market data API and ingestion workers",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migrate": "node --import ./test/node-preload.cjs --import tsx ./scripts/migrate.ts",
    "migrate:status": "node --import ./test/node-preload.cjs --import tsx ./scripts/migrate.ts --status",
    "check:cmc-access": "node --import ./test/node-preload.cjs --import tsx ./scripts/check-cmc-access.ts",
    "test": "node --import ./test/node-preload.cjs --import tsx --test test/*.test.ts",
    "lint:types": "tsc --noEmit"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "bullmq": "^6.5.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "lossless-json": "^4.3.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.15",
    "@types/pg": "^8.15.5",
    "@electric-sql/pglite": "^0.5.14",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
