NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://falconstats:falconstats@localhost:5432/falconstats
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=replace-with-a-long-random-secret

# Leave blank to use CoinMarketCap's documented keyless public API.
# Set a key only on the server; never expose it to the web client.
CMC_PRO_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_PUBLIC_API=true
CMC_CONVERT=USD
CMC_LISTINGS_LIMIT=100
CMC_INGEST_INTERVAL_SECONDS=300
CMC_HTTP_TIMEOUT_MS=10000
API_CACHE_TTL_SECONDS=30
DATA_STALE_AFTER_SECONDS=900
QUEUE_PREFIX=falconstats
