NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://falconstats:falconstats@localhost:5432/falconstats
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=replace-with-a-long-random-secret

# Optional CoinGecko Demo API key. Keep server-side; never expose as NEXT_PUBLIC_*.
COINGECKO_DEMO_API_KEY=
# Maximum 9,000 CoinGecko requests/month safety budget. 15-minute ingestion syncs at most 500 assets in two pages plus global metrics.
COINGECKO_MONTHLY_CALL_BUDGET=9000
COINGECKO_MARKET_PAGE_SIZE=250
MARKET_INGEST_INTERVAL_SECONDS=900
GLOBAL_METRICS_REFRESH_SECONDS=1800
PROVIDER_HTTP_TIMEOUT_MS=15000
MARKET_QUOTE_CURRENCY=usd

API_CACHE_TTL_SECONDS=30
DATA_STALE_AFTER_SECONDS=3600
QUEUE_PREFIX=falconstats
